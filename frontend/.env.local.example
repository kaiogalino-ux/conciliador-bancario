# Configuração do frontend. Copie para ".env.local" no desenvolvimento; na
# Vercel, defina as mesmas variáveis no painel do projeto.

# Endereço do backend Python. Local: o uvicorn rodando em backend/.
# Em produção: a URL do serviço no Render (ex.: https://conciliador-api.onrender.com).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Precisa ser igual ao API_TOKEN configurado no backend. Deixe vazio quando o
# backend também estiver sem token (uso local).
#
# Atenção: tudo que começa com NEXT_PUBLIC_ vai para o JavaScript enviado ao
# navegador e é visível por qualquer pessoa. Este token serve para barrar uso
# casual da API, não para autenticar usuários.
NEXT_PUBLIC_API_TOKEN=
